{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AwesomeGoogleAdsMCPRegistry",
  "type": "object",
  "required": ["version", "updated_at", "total_projects", "categories", "projects"],
  "properties": {
    "version": { "type": "string" },
    "updated_at": { "type": "string" },
    "total_projects": { "type": "integer" },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "number", "name", "slug", "description", "count", "subcategories"],
        "properties": {
          "id": { "type": "string" },
          "number": { "type": "integer" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "description": { "type": "string" },
          "count": { "type": "integer" },
          "subcategories": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "slug", "description", "count", "tool_slugs"],
              "properties": {
                "name": { "type": "string" },
                "slug": { "type": "string" },
                "description": { "type": "string" },
                "count": { "type": "integer" },
                "tool_slugs": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "repo",
          "url",
          "category_num",
          "subcategory_slug",
          "description",
          "role",
          "runtime",
          "transport",
          "search_stream",
          "dry_run",
          "live_mutations",
          "search_ads",
          "pmax_shopping",
          "video_display",
          "offline_conversions",
          "gaql_reflection",
          "sqlite_wal_cache",
          "query_latency",
          "mcp_apps_ui",
          "hitl_approval",
          "mcc_hierarchy",
          "token_refresh_daemon",
          "est_token_footprint",
          "pre_ai_pedigree",
          "testing_suite",
          "stars",
          "recency"
        ]
      }
    }
  }
}
